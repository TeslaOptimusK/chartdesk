<html>
<head>
<title>ChartDesk</title>
<HTA:APPLICATION
  ID="ChartDeskSplash"
  APPLICATIONNAME="ChartDesk"
  BORDER="none"
  CAPTION="no"
  SHOWINTASKBAR="yes"
  SINGLEINSTANCE="yes"
  SCROLL="no"
  SELECTION="no"
  CONTEXTMENU="no"
  WINDOWSTATE="normal" />
<meta http-equiv="X-UA-Compatible" content="IE=edge" />
<script type="text/javascript">
window.resizeTo(460, 280);
window.moveTo(
  Math.max(0, (screen.availWidth - 460) / 2),
  Math.max(0, (screen.availHeight - 280) / 2)
);
</script>
<style>
  html, body { margin: 0; height: 100%; overflow: hidden; background: #0b1220; }
  body {
    font-family: "Segoe UI", sans-serif;
    color: #e2e8f0;
  }
  .card {
    height: 100%;
    display: table;
    width: 100%;
    border: 1px solid #1e293b;
  }
  .inner { display: table-cell; vertical-align: middle; text-align: center; }
  .mark {
    width: 56px; height: 56px; margin: 0 auto 16px;
    border-radius: 14px;
    background: #14532d;
    color: #86efac;
    font-size: 28px;
    line-height: 56px;
    font-weight: 700;
  }
  h1 { margin: 0; font-size: 22px; font-weight: 650; letter-spacing: 0.02em; }
  p { margin: 10px 0 0; color: #94a3b8; font-size: 13px; }
  .bar {
    width: 180px; height: 3px; margin: 22px auto 0;
    background: #1e293b; border-radius: 99px; overflow: hidden;
  }
  .bar i {
    display: block; width: 40%; height: 100%;
    background: #34d399;
    animation: slide 1.1s ease-in-out infinite;
  }
  @keyframes slide {
    0% { margin-left: -40%; }
    100% { margin-left: 100%; }
  }
</style>
</head>
<body>
  <div class="card">
    <div class="inner">
      <div class="mark">C</div>
      <h1>ChartDesk</h1>
      <p>차트를 준비하고 있습니다</p>
      <div class="bar"><i></i></div>
    </div>
  </div>
</body>
</html>
