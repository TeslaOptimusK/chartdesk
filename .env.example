# Market data: delayed (default Yahoo) | mock | realtime
MARKET_DATA_MODE=delayed
# Live forming-bar tick interval (ms). Mock default 1000 so 1m wicks move.
# MARKET_DATA_TICK_MS=1000
# Optional vendor REST (used after Yahoo fails / as realtime supplement)
# MARKET_DATA_API_KEY=
# MARKET_DATA_BASE_URL=
# Poll interval (ms): delayed default 30000, realtime Yahoo poll default 3000
# MARKET_DATA_POLL_MS=3000
# Optional WebSocket feed: messages { "type":"candle", "payload": Candle }
# MARKET_DATA_WS_URL=

# Kiwoom broker adapter: mock (default) | ocx (Windows OpenAPI+ stub — not production)
# KIWOOM_MODE=mock
# Never commit real app keys / account numbers. Use env or local secrets only.
# KIWOOM_APP_KEY=
# KIWOOM_APP_SECRET=
# KIWOOM_ACCOUNT_NO=

# Optional LLM for symbol extract / opinion drafts / pattern extract
# OPENAI_API_KEY or LLM_API_KEY — without keys, rule/heuristic extractors are used.
# OPENAI_API_KEY=
# LLM_API_KEY=
# LLM_BASE_URL=https://api.openai.com/v1/chat/completions
# LLM_MODEL=gpt-4o-mini
