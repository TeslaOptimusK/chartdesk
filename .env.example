# Market data: mock | delayed | realtime
MARKET_DATA_MODE=mock
# MARKET_DATA_API_KEY=
# MARKET_DATA_BASE_URL=
# Fast poll when mode=realtime (ms); delayed default 30000
# MARKET_DATA_POLL_MS=3000
# Optional WebSocket feed: messages { "type":"candle", "payload": Candle }
# MARKET_DATA_WS_URL=

# Optional LLM for symbol extract / opinion drafts / pattern drafts
# Without these, rule-based heuristics are used.
# LLM_API_KEY=
# LLM_BASE_URL=https://api.openai.com/v1/chat/completions
# LLM_MODEL=gpt-4o-mini
